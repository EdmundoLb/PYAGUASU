# Copiar este archivo a .env.local y completar la key del proveedor que uses.
# .env.local nunca se commitea (ver .gitignore).

# Gemini (Google AI Studio: https://aistudio.google.com/apikey) — proveedor por defecto.
# Se pueden poner varias keys separadas por coma (key1,key2): la cuota
# gratuita es por key, y si una se queda sin cuota o sin respuesta se usa la
# siguiente.
GEMINI_API_KEY=

# Alternativa: Anthropic (Claude). Con esta sola alcanza si no ponés Gemini.
# Si están las dos, la otra se usa de respaldo automático cuando el
# proveedor principal falla (ej. Gemini saturado con 503).
ANTHROPIC_API_KEY=

# Opcional (Claude): modelo y nivel de "pensamiento". Por defecto
# claude-opus-5 con esfuerzo 'low' (responde rápido). Valores de esfuerzo:
# low | medium | high | xhigh | max.
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low

# Opcional: forzar el proveedor ('gemini' o 'claude'). Si se deja vacío,
# se usa Gemini si hay GEMINI_API_KEY, si no Claude si hay ANTHROPIC_API_KEY.
AI_PROVIDER=

# Opcional: modelo principal de Gemini y cadena de respaldo (separada por
# comas). Ver src/lib/ai/providers/gemini.js para los valores por defecto.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FALLBACK=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash

# Opcional: nivel de "pensamiento" del modelo antes de responder. Es lo que
# más pesa en la demora: LOW ≈ 3 s por turno (por defecto), normal ≈ 12-14 s.
# Valores: LOW | MEDIUM | HIGH | normal.
# GEMINI_THINKING=LOW
